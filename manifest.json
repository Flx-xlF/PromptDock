{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "promptdock@flx.dev",
      "strict_min_version": "115.0"
    }
  },
  "name": "PromptDock",
  "version": "1.0.0",
  "description": "One-click prompt injection, inline commenting, and rewriting for AI assistants (Copilot, Gemini).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptDock",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.microsoft.com/*",
    "*://*.cloud.microsoft/*",
    "*://*.microsoft365.com/*",
    "*://*.office.com/*",
    "*://*.office365.com/*",
    "*://*.office.net/*",
    "*://*.bing.com/*",
    "*://gemini.google.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.microsoft.com/*",
        "*://*.cloud.microsoft/*",
        "*://*.microsoft365.com/*",
        "*://*.office.com/*",
        "*://*.office365.com/*",
        "*://*.office.net/*",
        "*://*.bing.com/*",
        "*://gemini.google.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ],
  "commands": {
    "run-prompt-0": {
      "description": "Run Prompt 1"
    },
    "run-prompt-1": {
      "description": "Run Prompt 2"
    },
    "run-prompt-2": {
      "description": "Run Prompt 3"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "*://*.microsoft.com/*",
        "*://*.cloud.microsoft/*",
        "*://*.microsoft365.com/*",
        "*://*.office.com/*",
        "*://*.office365.com/*",
        "*://*.office.net/*",
        "*://*.bing.com/*",
        "*://gemini.google.com/*"
      ]
    }
  ]
}
