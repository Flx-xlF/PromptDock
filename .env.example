# --------------------------------------------------
# Outlook Agents — Environment Configuration
# Copy to .env and adjust values as needed.
# --------------------------------------------------

# Chrome DevTools Protocol endpoint (Edge must be launched with --remote-debugging-port)
CDP_URL=http://localhost:9222

# How often (seconds) the script checks for new emails
POLL_INTERVAL_SECONDS=30

# File path for persisting processed email IDs across restarts
PROCESSED_EMAILS_FILE=processed_emails.json

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
